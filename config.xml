<?xml version='1.0' encoding='utf-8'?>
<widget id="com.goldenchickenproskat.app" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Golden Chicken Pro Skater</name>
    <description>Una gallina que skateboard! Hacé trucos, recolectá huevos y desbloquea mascotas en mapas gigantes.</description>
    <author email="dev@goldenchicken.com" href="https://goldenchicken.com/">Claude & Matheo</author>
    <content src="index.html" />
    <plugin name="cordova-plugin-whitelist" spec="1" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <platform name="android">
        <allow-intent href="market:*" />
        <preference name="Orientation" value="landscape" />
        <preference name="android:targetSdkVersion" value="33" />
    </platform>
    <engine name="android" spec="^13.0.0" />
</widget>
